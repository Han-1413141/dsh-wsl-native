{
  "name": "dsh-wsl-native",
  "version": "0.5.0",
  "description": "DSH for WSL: Windows and WSL hosts, resident stdio bridges, native Linux launch and Windows interoperability",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./lib/client.js",
    "./service": "./src/service.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-wsl": "bin/dsh-wsl.mjs"
  },
  "files": [
    "src",
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "test:wsl": "node scripts/wsl-smoke.mjs",
    "test:host": "node scripts/host-smoke.mjs",
    "test:native": "node scripts/native-host-smoke.mjs",
    "test:inheritance": "node scripts/inheritance-smoke.mjs",
    "bench:wsl": "node scripts/benchmark.mjs",
    "check": "node scripts/check.mjs",
    "test:package": "node scripts/package-smoke.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "esbuild": "^0.25.0",
    "yaml": "2.9.1"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "wsl",
    "windows",
    "interop"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Han-1413141/dsh-wsl-native.git"
  },
  "homepage": "https://github.com/Han-1413141/dsh-wsl-native#readme",
  "bugs": {
    "url": "https://github.com/Han-1413141/dsh-wsl-native/issues"
  }
}
